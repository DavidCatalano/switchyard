# Switchyard environment configuration
# Copy to .env and adjust as needed.
# All fields are optional — sensible defaults apply for local Docker.

# Path to YAML config file (required unless passed at startup)
# Relative paths are resolved from the directory containing .env
# SWITCHYARD_CONFIG_PATH=config.yaml

# Process-local bootstrap settings
# SWITCHYARD_LOG_LEVEL=info
# SWITCHYARD_API_HOST=0.0.0.0
# SWITCHYARD_API_PORT=8000

# Active host from config.yaml (required for API proxy routes)
# SWITCHYARD_ACTIVE_HOST=trainbox

# Docker API endpoint. Set for remote Docker (SSH tunnel, etc.).
# Example: tcp://127.0.0.1:2375
# SWITCHYARD_DOCKER_HOST=

# Backend proxy timeout defaults
# Connect/write/pool protect setup and request-body transfer.
# Non-stream read covers long non-streaming inference responses.
# Stream read is disabled by default so long-running SSE streams are not
# interrupted while tokens are still arriving slowly.
# SWITCHYARD_PROXY_CONNECT_TIMEOUT_SECONDS=5
# SWITCHYARD_PROXY_WRITE_TIMEOUT_SECONDS=30
# SWITCHYARD_PROXY_POOL_TIMEOUT_SECONDS=30
# SWITCHYARD_PROXY_NON_STREAM_READ_TIMEOUT_SECONDS=600
# SWITCHYARD_PROXY_STREAM_READ_TIMEOUT_SECONDS=
